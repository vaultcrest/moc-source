[Unit]
Description=MOC Source PAB multi-region scraper
After=postgresql.service

[Service]
Type=oneshot
User=mocsource
WorkingDirectory=/opt/mocsource/app
ExecStart=/opt/mocsource/venv/bin/python scripts/scrape_pab.py
EnvironmentFile=/opt/mocsource/app/.env
StandardOutput=journal
StandardError=journal
