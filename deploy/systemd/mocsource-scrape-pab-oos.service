[Unit]
Description=MOC Source PAB OOS stock check (en-us, de-de, ko-kr)
After=postgresql.service

[Service]
Type=oneshot
User=mocsource
WorkingDirectory=/opt/mocsource/app
ExecStart=/opt/mocsource/venv/bin/python scripts/scrape_pab.py --mode oos
EnvironmentFile=/opt/mocsource/app/.env
StandardOutput=journal
StandardError=journal
